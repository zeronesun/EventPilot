# Django配置
DJANGO_SECRET_KEY=t%-S-e...>?0F
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,172.28.166.164
DJANGO_LOG_LEVEL=INFO

# 数据库配置 (开发环境使用SQLite)
USE_SQLITE=True
DB_NAME=eventpilot_dev.db

# PostgreSQL配置 (仅在生产环境使用)
# USE_SQLITE=False 时以下配置生效
# DB_NAME=eventpilot_dev
# DB_USER=postgres
# DB_PASSWORD=***
# DB_HOST=localhost
# DB_PORT=5432

# Redis配置 (开发环境暂时禁用)
REDIS_URL=redis://localhost:6379/0

# JWT认证
JWT_SECRET_KEY=jwt-de...2024
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=86400

# 文件存储（本地存储）
USE_LOCAL_STORAGE=True
MEDIA_ROOT=./public/media
STATIC_ROOT=./public/static

# 对象存储（可选，用于生产环境）
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=AWS_S3...ilot
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# 微信集成
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 邮件配置
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=DEFAULT_EMAIL_PASSWORD_HERE

# 监控配置
SENTRY_DSN=
ENABLE_PERFORMANCE_MONITORING=True

# 应用配置
DEPLOYMENT_MODE=traditional
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Gunicorn配置
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_BIND=127.0.0.1:8000

# Gemini配置 - 替换为你实际的API key
GEMINI_API_KEY=your_gemini_api_key_here