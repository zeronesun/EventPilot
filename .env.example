# Django配置
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_LOG_LEVEL=INFO

# 数据库配置
DB_NAME=eventpilot
DB_USER=eventpilot
DB_PASSWORD=your-secure-password-change-this
DB_HOST=localhost
DB_PORT=5432

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT认证
JWT_SECRET_KEY=your-jwt-secret-key-different-from-django-secret
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800

# 文件存储（本地存储）
USE_LOCAL_STORAGE=True
MEDIA_ROOT=/var/www/eventpilot/media
STATIC_ROOT=/var/www/eventpilot/static

# 对象存储（可选，用于生产环境）
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=eventpilot-files
AWS_S3_ENDPOINT=https://s3.amazonaws.com
STORAGE_PATH_PREFIX=files

# 微信集成
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 邮件配置
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# 监控配置
SENTRY_DSN=
ENABLE_PERFORMANCE_MONITORING=True

# 应用配置
DEPLOYMENT_MODE=traditional
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Gunicorn配置
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_BIND=127.0.0.1:8000